# --- PWA (Firebase web). Sin estas variables la app anda en "modo local". ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=

# --- Server (/api y cron). Sin credenciales la caché queda en memoria. ---
# O bien el JSON completo de la cuenta de servicio en una línea:
FIREBASE_SERVICE_ACCOUNT=
# …o bien estas tres:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" al llamar /api/refrescar.
CRON_SECRET=

# Zona de entrega (ver README → "Zona de entrega")
CODIGO_POSTAL=
VTEX_SC_JUMBO=32
VTEX_SC_VEA=34
VTEX_SC_CARREFOUR=1

# Opcionales
HORAS_CACHE=12
SCRAPERS_INTERVALO_MS=1200
REFRESCAR_MAXIMO=150
# SCRAPERS_FIXTURES=1  → los scrapers usan los fixtures (precios ficticios), sin red
